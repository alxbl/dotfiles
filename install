#!/bin/zsh

if [[ $UID -eq 0 ]]; then
   echo "Why would you install your dotfiles as root? Silly."
   exit 1;
fi

echo -n "Are you sure you want to install? This will overwrite any existing tracked dotfile in ~/. [yN] "
read __R
if [[ $__R != "y" ]]; then
    echo "Aborting..."
    exit 130;
fi

BASE=`basename $0`
if [[ ! -f "./$BASE" ]]; then
    echo "You must run this script from within the repository!"
    exit 1;
fi

echo ">> Updating submodules"
git submodule update --init --recursive

echo ">> Deploying dotfiles"

DST=$(pwd)
FILES=$(ls -A)

for FILE in $(ls -A); do
    # Don't link the installer or .git folder. ~/.config is a real directory holding app state, see below.
    if [[ $BASE == $FILE || $FILE == ".git"  || $FILE == ".gitmodules" || $FILE == ".gitignore" || $FILE == ".config" ]]; then
	continue
    fi

    if [[ -f "$HOME/$FILE" || -d "$HOME/$FILE" ]]; then
        echo "  +Update:  $FILE"
    else
        echo "  +Install: $FILE"
    fi
    ln -f -s "$DST/$FILE" "$HOME/$FILE"
done

echo ">> Linking ~/.config"
# Link each tracked file individually so app state never lands in the repo,
# and so that running this from a worktree repoints only the files it tracks.
# mv -T over a temporary link swaps each file atomically.
mkdir -p "$HOME/.config"
for FILE in ${(0)"$(git ls-files -z .config)"}; do
    mkdir -p "$HOME/${FILE:h}"
    ln -sf "$DST/$FILE" "$HOME/$FILE.install" && mv -T "$HOME/$FILE.install" "$HOME/$FILE" || echo "  !Failed:  $FILE"
done

echo ">> Linking agent skills"
mkdir -p "$HOME/.claude/skills"
for SKILL in "$HOME"/.config/agents/skills/loop-*(/N); do
    ln -sfn "$SKILL" "$HOME/.claude/skills/${SKILL:t}"
done

echo ">> Linking agent rules"
ln -f -s "$HOME/.config/agents/rules" "$HOME/.claude/CLAUDE.md"

#echo ">> Done copying files. Post-install routine"
#if [ -d ".ssh" ]; then
#    echo "  +chmod: .ssh (700)"
#    chmod 700 ~/.ssh
#fi

echo ">> Done!"
