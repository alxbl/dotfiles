function is_git_repo() {
    local dir="$PWD"
    while true; do
        # -e because .git is a file in worktrees
        [ -e "$dir/.git" ] && return 0
        [ "$dir" = "/" ] && return 1
        dir="${dir:h}"
    done
}

# worktree_path NAME
# Prints the path of a worktree for NAME next to the main worktree. Fails when the main worktree isn't named `main`.
function worktree_path() {
    local main=$(git worktree list --porcelain | awk '/^worktree /{print substr($0,10); exit}')
    [ "${main:t}" = main ] || return 1
    echo "${main:h}/${1//\//-}"
}

# co [BRANCH]
# Checks out or moves to the worktree of the selected branch, creating it next to the main worktree when missing.
# When the main worktree doesn't follow `[repo]/[worktree]` convention, switches branch in-place.
function co() {
    if ! is_git_repo; then
        echo "Not a git repository."
        return 1
    fi
    local branch="$1"
    if [ -n "$branch" ]; then
        if ! git show-ref --verify --quiet "refs/heads/$branch"; then
            echo "Branch '$branch' does not exist."
            return 1
        fi
    else
        branch=$(git branch | fzf | sed -r 's#^[[:space:]*+]*##')
    fi
    [ -n "$branch" ] || return 1

    local dir=$(git worktree list --porcelain | awk -v b="refs/heads/$branch" \
        '/^worktree /{p=substr($0,10)} $1=="branch" && $2==b {print p; exit}')
    if [ -z "$dir" ]; then
        # Doesn't follow [repo]/main, checkout in-place.
        dir=$(worktree_path "$branch") || { git checkout "$branch"; return; }
        git worktree add "$dir" "$branch" || return 1
    fi
    cd "$dir"
}

# b [NAME]
# Creates branch NAME from the current HEAD in a new worktree next to the main worktree, and moves to it.
# When the main worktree doesn't follow `[repo]/[worktree]` convention, creates and switches to the branch in-place.
function b() {
    if [ -z "$1" ]; then
        echo "usage: b NAME" >&2
        return 1
    fi
    if ! is_git_repo; then
        echo "Not a git repository."
        return 1
    fi
    if git show-ref --verify --quiet "refs/heads/$1"; then
        echo "Branch '$1' already exists."
        return 1
    fi

    local dir
    dir=$(worktree_path "$1") || { git checkout -b "$1"; return; }
    git worktree add -b "$1" "$dir" HEAD || return 1
    cd "$dir"
}

function gwl() {
    case "$1" in
        ""|prune|go) ;;
        *)
            echo "usage: gwl [go|prune]" >&2
            return 1
            ;;
    esac

    if ! is_git_repo; then
        echo "Not a git repository."
        return 1
    fi

    if [ "$1" = go ]; then
        local dir
        dir=$(git worktree list | fzf --prompt='worktree> ' | awk '{print $1}')
        [ -n "$dir" ] && cd "$dir"
    elif [ "$1" = prune ]; then
        git worktree prune
    else
        git worktree list
    fi
}

function www
{
    if ! is_git_repo; then
        echo "Not a git repository."
        return 1
    fi
    local url=$(git remote get-url origin)

    if [[ $url =~ ^https://([^/]+)/? ]]; then
        local host="${match[1]}"
        case "$host" in
            "aur.archlinux.org")
                local url=$(echo $url | sed -e 's#.org/\(\w*\).git$#.org/packages/\1#')
                browse $url
                ;;
            *)
                browse $url
                ;;
        esac
    elif [[ $url =~  ^git@([^:]+):(.+) ]]; then
        local host=${match[1]}
        local _path=${match[2]}

        case "$host" in
            "ssh.dev.azure.com")
                local parts=(${(@s:/:)_path})
                local project=${parts[-1]}
                shift parts # v3
                shift -p parts # project
                local url="https://dev.azure.com/${(j:/:)parts}/_git/$project"
                browse $url
                ;;
        esac
    fi
}

function browse {
    firefox $1
}
