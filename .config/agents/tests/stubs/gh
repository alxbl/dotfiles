#!/usr/bin/env bash
# Fake gh for the loop tests. Supports only the calls the loop scripts make.
# State lives in $FAKE_GH: issues/<n>/{labels,created,comments}, prs/<n>/{body,comments}.
set -euo pipefail
echo "gh $*" >>"$FAKE_GH/calls.log"

now() { date -u +%Y-%m-%dT%H:%M:%S.%NZ; }

issue_json() {
  local d=$FAKE_GH/issues/$1
  jq -n --argjson n "$1" --arg c "$(cat "$d/created")" --rawfile l "$d/labels" \
    '{number: $n, createdAt: $c, labels: ($l | split("\n") | map(select(. != "")) | map({name: .}))}'
}

case "$1 $2" in
  "repo view") jq -n --arg r "$FAKE_REPO" '{nameWithOwner: $r}' ;;
  "issue list")
    for d in "$FAKE_GH"/issues/*/; do
      if [[ -d $d ]]; then issue_json "$(basename "$d")"; fi
    done | jq -s . ;;
  "issue view")
    case $5 in
      labels) issue_json "$3" ;;
      comments) jq -s '{comments: .}' "$FAKE_GH/issues/$3/comments" ;;
    esac ;;
  "issue edit")
    f=$FAKE_GH/issues/$3/labels; shift 3
    while (( $# )); do
      case $1 in
        --add-label) grep -qxF "$2" "$f" || echo "$2" >>"$f" ;;
        --remove-label) grep -vxF "$2" "$f" >"$f.tmp" || true; mv "$f.tmp" "$f" ;;
      esac
      shift 2
    done ;;
  "issue comment") jq -cn --arg b "$5" --arg t "$(now)" '{body: $b, createdAt: $t}' >>"$FAKE_GH/issues/$3/comments" ;;
  "pr comment") jq -cn --arg b "$5" --arg t "$(now)" '{body: $b, createdAt: $t}' >>"$FAKE_GH/prs/$3/comments" ;;
  "label create") ;;
  "pr list")
    for d in "$FAKE_GH"/prs/*/; do
      if [[ -d $d ]]; then jq -n --argjson n "$(basename "$d")" --rawfile b "$d/body" '{number: $n, body: $b}'; fi
    done | jq -s . ;;
  "pr view") jq -s '{comments: .}' "$FAKE_GH/prs/$3/comments" ;;
  *) echo "fake gh: unsupported: $*" >&2; exit 1 ;;
esac
