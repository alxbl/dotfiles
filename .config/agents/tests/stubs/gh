#!/usr/bin/env bash
# Fake gh for the loop tests. Supports only the calls the loop scripts make.
# State lives in $FAKE_GH: issues/<n>/{labels,created}. The loop only changes labels, so it has no comment or PR calls.
set -euo pipefail
echo "gh $*" >>"$FAKE_GH/calls.log"

now() { date -u +%Y-%m-%dT%H:%M:%S.%NZ; }

issue_json() {
  local d=$FAKE_GH/issues/$1
  jq -n --argjson n "$1" --arg c "$(cat "$d/created")" --rawfile l "$d/labels" \
    '{number: $n, createdAt: $c, labels: ($l | split("\n") | map(select(. != "")) | map({name: .}))}'
}

case "$1 $2" in
  "repo view") jq -n --arg r "$FAKE_REPO" '{nameWithOwner: $r}' ;;
  "issue list")
    for d in "$FAKE_GH"/issues/*/; do
      if [[ -d $d ]]; then issue_json "$(basename "$d")"; fi
    done | jq -s . ;;
  "issue view") issue_json "$3" ;;
  "issue edit")
    f=$FAKE_GH/issues/$3/labels; shift 3
    while (( $# )); do
      case $1 in
        --add-label) grep -qxF "$2" "$f" || echo "$2" >>"$f" ;;
        --remove-label) grep -vxF "$2" "$f" >"$f.tmp" || true; mv "$f.tmp" "$f" ;;
      esac
      shift 2
    done ;;
  "label create") ;;
  *) echo "fake gh: unsupported: $*" >&2; exit 1 ;;
esac
